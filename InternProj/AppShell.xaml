<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="InternProj.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:InternProj.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="InternProj">



    <ShellContent
        Title="Màn hình chính"

        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="mainpage" />

    <ShellContent
        Title="Đơn vị tính"

        ContentTemplate="{DataTemplate pages:DonViTinhPage}"
        Route="donvitinh" />
    
    <ShellContent    
        Title="Loại Sản Phẩm"

        ContentTemplate="{DataTemplate pages:LoaiSanPhamPage}"
        Route="loaisanpham" />


</Shell>
