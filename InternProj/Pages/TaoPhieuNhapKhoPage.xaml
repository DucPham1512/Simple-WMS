<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InternProj.Pages.TaoPhieuNhapKhoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:InternProj.Models"
    Title="Tạo phiếu nhập kho">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">

            <!-- Header -->
            <Label Text="Thông tin phiếu nhập" FontAttributes="Bold" FontSize="16" />

            <Label Text="Số phiếu nhập" />
            <Entry Text="{Binding SoPhieuNhapKhoInput}"
                    />

            <Label Text="Ngày nhập kho" />
            <Entry Text="{Binding NgayNhapKhoInput}"
                   Placeholder="VD: 27/02/2026" />

            <Label Text="Kho ID" />
            <Entry Text="{Binding KhoIdInput}"
                   Keyboard="Numeric"
                    />

            <Label Text="NCC ID" />
            <Entry Text="{Binding NccInput}"
                   Keyboard="Numeric"
                    />

            <Label Text="Ghi chú" />
            <Entry Text="{Binding GhiChuInput}"
                   Placeholder="Ghi chú (nếu có)" />

            <!-- Line input -->
            <BoxView HeightRequest="1" Opacity="0.2" />

            <Label Text="Thêm hàng" FontAttributes="Bold" FontSize="16" />

            <Label Text="Sản phẩm ID" />
            <Entry Text="{Binding SanPhamIdInput}"
                   Keyboard="Numeric"
                   Placeholder="VD: 5" />

            <Label Text="Số lượng nhập" />
            <Entry Text="{Binding SoLuongInput}"
                   Keyboard="Numeric"
                   Placeholder="VD: 10" />

            <Label Text="Đơn giá nhập" />
            <Entry Text="{Binding DonGiaInput}"
                   Keyboard="Numeric"
                   Placeholder="VD: 25000" />

            <HorizontalStackLayout Spacing="12">
                <Button Text="Thêm dòng"
                        Command="{Binding AddLineCommand}" />

                <Button Text="Lưu phiếu nhập"
                        Command="{Binding SaveCommand}" />
            </HorizontalStackLayout>

            <!-- Added lines -->
            <BoxView HeightRequest="1" Opacity="0.2" />

            <Label Text="Danh sách dòng hàng" FontAttributes="Bold" FontSize="16" />

            <CollectionView ItemsSource="{Binding DanhSachDong}">
                <CollectionView.EmptyView>
                    <Label Text="Chưa có dòng hàng nào."
                           Opacity="0.7"
                           Padding="8" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PhieuNhapKhoRawData">
                        <Grid ColumnDefinitions="*,Auto" Padding="8">

                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding SanPhamId, StringFormat='SP: {0}'}"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding SoLuong, StringFormat='SL: {0}'}" />
                                    <Label Text="{Binding DonGia, StringFormat='ĐG: {0}'}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Xóa"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                      Path=BindingContext.RemoveLineCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>