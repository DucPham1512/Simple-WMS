<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InternProj.Pages.TaoPhieuNhapKhoPage"
    x:Name="EditPhieuNhapKho"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:InternProj.Models"
    xmlns:sfgrid="http://schemas.syncfusion.com/maui"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    Title="Tạo phiếu nhập kho">

    <ScrollView x:Name="RootLayout">
        <VerticalStackLayout Spacing="12" Padding="16">
            <VerticalStackLayout.Resources>
                <!-- Header style -->
                <Style TargetType="sfgrid:DataGridHeaderCell">
                    <Setter Property="Background" Value="#F2F2F2" />
                    <Setter Property="TextColor" Value="#222222" />
                    <Setter Property="FontAttributes" Value="Bold" />
                </Style>

                <Style TargetType="sfgrid:DataGridCell">
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="FontFamily" Value="Tahoma" />
                    <Setter Property="TextColor" Value="#222222" />
                </Style>


                <!-- Row style -->
                <Style TargetType="sfgrid:DataGridRow">
                    <Setter Property="Background" Value="#F2F2F2" />
                </Style>
            </VerticalStackLayout.Resources>

            <!-- Header -->
            <Label Grid.Row="0" Grid.Column="0" 
                   Text="Thông tin phiếu nhập" 
                   FontAttributes="Bold" FontSize="16" />
            <Grid ColumnDefinitions="*, *, *, *,*" 
                  ColumnSpacing="12" 
                  RowSpacing="12">

                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Số phiếu nhập" />
                    <Entry Text="{Binding SoPhieuNhapKhoInput}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Ngày nhập kho" />
                    <DatePicker Date="{Binding NgayNhapKhoInput}" Format="dd-MM-yyyy" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" >
                    <Label Text="Kho" />
                    <editors:SfComboBox
                        ItemsSource="{Binding DanhSachKho}"
                        DisplayMemberPath="Ten_Kho"
                        SelectedItem="{Binding SelectedKho, Mode=TwoWay}"
                        IsEditable="True"
                        IsFilteringEnabled="True"
                        TextSearchMode="Contains"
                        Placeholder="Chọn kho..."
                        MaxDropDownHeight="250" 
                        HeightRequest="44"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        DropDownIconColor="White"
                        SelectionTextHighlightColor="DodgerBlue"
                        ClearButtonIconColor="White"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3">
                    <Label Text="NCC" />
                    <editors:SfComboBox
                        ItemsSource="{Binding DanhSachNCC}"
                        DisplayMemberPath="Ten_Ncc"
                        SelectedItem="{Binding SelectedNCC, Mode=TwoWay}"
                        IsEditable="True"
                        IsFilteringEnabled="True"
                        TextSearchMode="Contains"
                        Placeholder="Tìm kiếm nhà cung cấp..."
                        MaxDropDownHeight="300" 
                        HeightRequest="44"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        DropDownIconColor="White"
                        SelectionTextHighlightColor="DodgerBlue"
                        ClearButtonIconColor="White"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4">
                    <Label Text="Ghi chú" />
                    <Entry Text="{Binding GhiChuInput}" />
                </VerticalStackLayout>

            </Grid>

            <!-- Line input -->
            <BoxView HeightRequest="1" Opacity="0.2" />

            <Label Text="Thêm hàng" FontAttributes="Bold" FontSize="16" />

            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="12" RowSpacing="12">
                <VerticalStackLayout Grid.Column="0">
                    <VerticalStackLayout.Resources>
                        <!-- Header style -->
                        <Style TargetType="sfgrid:DataGridHeaderCell">
                            <Setter Property="Background" Value="#F2F2F2" />
                            <Setter Property="TextColor" Value="#222222" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </Style>

                        <Style TargetType="sfgrid:DataGridCell">
                            <Setter Property="FontSize" Value="15" />
                            <Setter Property="FontFamily" Value="Tahoma" />
                            <Setter Property="TextColor" Value="#222222" />
                        </Style>


                        <!-- Row style -->
                        <Style TargetType="sfgrid:DataGridRow">
                            <Setter Property="Background" Value="#F2F2F2" />
                        </Style>
                    </VerticalStackLayout.Resources>
                    <Label Text="Sản phẩm" />
                    <editors:SfComboBox
                        Grid.Column="0"
                        ItemsSource="{Binding DanhSachSP}"
                        DisplayMemberPath="Ten_SP"
                        SelectedItem="{Binding SelectedSP, Mode=TwoWay}"
                        IsEditable="True"
                        IsFilteringEnabled="True"
                        TextSearchMode="Contains"
                        Placeholder="Tìm tên hoặc mã sản phẩm..."
                        MaxDropDownHeight="300" 
                        HeightRequest="44"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        DropDownIconColor="White"
                        SelectionTextHighlightColor="DodgerBlue"
                        ClearButtonIconColor="White"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1">
                    <VerticalStackLayout.Resources>
                        <!-- Header style -->
                        <Style TargetType="sfgrid:DataGridHeaderCell">
                            <Setter Property="Background" Value="#F2F2F2" />
                            <Setter Property="TextColor" Value="#222222" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </Style>

                        <Style TargetType="sfgrid:DataGridCell">
                            <Setter Property="FontSize" Value="15" />
                            <Setter Property="FontFamily" Value="Tahoma" />
                            <Setter Property="TextColor" Value="#222222" />
                        </Style>


                        <!-- Row style -->
                        <Style TargetType="sfgrid:DataGridRow">
                            <Setter Property="Background" Value="#F2F2F2" />
                        </Style>
                    </VerticalStackLayout.Resources>
                    <Label Text="Số lượng nhập" />
                    <Entry Text="{Binding SoLuongInput}"
                       Keyboard="Numeric"
                       Grid.Column="1"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2">
                    <VerticalStackLayout.Resources>
                        <!-- Header style -->
                        <Style TargetType="sfgrid:DataGridHeaderCell">
                            <Setter Property="Background" Value="#F2F2F2" />
                            <Setter Property="TextColor" Value="#222222" />
                            <Setter Property="FontAttributes" Value="Bold" />
                        </Style>

                        <Style TargetType="sfgrid:DataGridCell">
                            <Setter Property="FontSize" Value="15" />
                            <Setter Property="FontFamily" Value="Tahoma" />
                            <Setter Property="TextColor" Value="#222222" />
                        </Style>


                        <!-- Row style -->
                        <Style TargetType="sfgrid:DataGridRow">
                            <Setter Property="Background" Value="#F2F2F2" />
                        </Style>
                    </VerticalStackLayout.Resources>
                    <Label Text="Đơn giá nhập" />
                    <Entry Text="{Binding DonGiaInput}"
                   Keyboard="Numeric"
                   Grid.Column="2"/>
                </VerticalStackLayout>
            </Grid>

            <HorizontalStackLayout Spacing="12">
                <Button Text="Thêm dòng"
                        Command="{Binding AddLineCommand}" />

                <Button Text="Lưu phiếu nhập"
                        Command="{Binding SaveCommand}" />
            </HorizontalStackLayout>

            <!-- Added lines -->
            <BoxView HeightRequest="1" Opacity="0.2" />

            <Label Text="Danh sách dòng hàng" FontAttributes="Bold" FontSize="16" />
            <sfgrid:SfDataGrid
                    AllowEditing="true"
                    ItemsSource="{Binding DanhSachDong}"
                    AutoGenerateColumnsMode="None"
                    SelectionMode="Single"
                    CurrentCellEndEdit="ReCalcThanhTien"
                    GridLinesVisibility="Both"
                    HeaderGridLinesVisibility="Both"
                    ColumnWidthMode="Fill"
                    HeaderRowHeight="44"
                    RowHeight="52">

                <sfgrid:SfDataGrid.DefaultStyle>
                    <sfgrid:DataGridStyle
                        HeaderRowBackground="#F2F2F2"
                        HeaderRowTextColor="#222222"
                        HeaderGridLineColor="#BDBDBD"
                        HeaderGridLineStrokeThickness="1"
                        GridLineColor="#BDBDBD"
                        GridLineStrokeThickness="1" />
                </sfgrid:SfDataGrid.DefaultStyle>

                <sfgrid:SfDataGrid.Columns>
                    <sfgrid:DataGridTextColumn MappingName="MaSP"
                                               AllowEditing = "False"
                                   HeaderText="Mã sản phẩm" />
                    <sfgrid:DataGridTextColumn MappingName="TenSP"
                                               AllowEditing = "False"
                                   HeaderText="Tên sản phẩm" />
                    <sfgrid:DataGridTextColumn MappingName="SoLuong"
                                   HeaderText="Số lượng"/>
                    <sfgrid:DataGridTextColumn MappingName="DonGia"
                                   HeaderText="Đơn giá" />
                    <sfgrid:DataGridTextColumn MappingName="ThanhTien"
                                               AllowEditing="False"
                                   HeaderText="Giá Trị" />

                    <sfgrid:DataGridTemplateColumn MappingName="Dummy" HeaderText="Xóa" Width="100" CellPadding="3">
                        <sfgrid:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button
                                    Text="Xóa"
                                    Command="{Binding Source={x:Reference RootLayout}, Path=BindingContext.RemoveLineCommand}"
                                    CommandParameter="{Binding .}"
                                    WidthRequest="60"
                                    HeightRequest="32"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Padding="6,2" />
                                </Grid>
                            </DataTemplate>
                        </sfgrid:DataGridTemplateColumn.CellTemplate>
                    </sfgrid:DataGridTemplateColumn>
                </sfgrid:SfDataGrid.Columns>
            </sfgrid:SfDataGrid>

            <Grid ColumnDefinitions="*,*,*,*,*,100"
          BackgroundColor="#D6D6D6"
          Padding="8,6"
          MinimumHeightRequest="36">
                <Label Grid.Column="0" Text="" />
                <Label Grid.Column="1"
               Text="Tổng cộng"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               TextColor="Black"/>
                <Label Grid.Column="2"
               Text="{Binding TongSoLuong, StringFormat='{0:#,##0.####}'}"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               TextColor="Black"/>
                <Label Grid.Column="3" Text="" />
                <Label Grid.Column="4"
               Text="{Binding TongThanhTien, StringFormat='{0:#,##0.####}'}"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               TextColor="Black"/>
                <Label Grid.Column="5" Text="" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


 
