<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InternProj.Pages.KhoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:InternProj.Models"
    Title="Danh mục kho">

    <VerticalStackLayout Spacing="12" Padding="16">

        <ScrollView Orientation="Horizontal">
            <Grid ColumnSpacing="16" RowSpacing="6"
          RowDefinitions="Auto,Auto"
          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">

                <!-- Column 1: Tên sản phẩm -->
                <Label Grid.Row="0" Grid.Column="1"
               Text="Tên kho"
               LineBreakMode="TailTruncation"
               MaximumWidthRequest="120" />
                <Entry Grid.Row="1" Grid.Column="1"
               WidthRequest="260"
               Text="{Binding TenKhoInput}"
               />

                <Label Grid.Row="0" Grid.Column="4"
               Text="Ghi chú"
               LineBreakMode="TailTruncation"
               MaximumWidthRequest="100" />
                <Entry Grid.Row="1" Grid.Column="4"
               WidthRequest="260"
               Text="{Binding GhiChuInput}"
               Placeholder="Ghi chú (nếu có)" />

            </Grid>
        </ScrollView>
        <!-- Buttons -->
        <HorizontalStackLayout Spacing="12">
            <Button Text="Load"
                    Command="{Binding LoadDataCommand}" />

            <Button Text="Save"
                    Command="{Binding SaveCommand}" />
        </HorizontalStackLayout>

        <!-- List -->
        <Label Text="Danh sách loại sản phẩm" FontAttributes="Bold" />

        <CollectionView ItemsSource="{Binding DanhSachKho}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Kho">
                    <Grid ColumnDefinitions="*,Auto" Padding="8">
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Id}" FontAttributes="Bold"/>
                                <Label Text="{Binding Ten_Kho}" FontAttributes="Bold" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding Ghi_Chu}" FontSize="12" Opacity="0.7" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Xóa"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>