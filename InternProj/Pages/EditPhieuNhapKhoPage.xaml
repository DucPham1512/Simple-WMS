<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InternProj.Pages.EditPhieuNhapKhoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:InternProj.Models"
    Title="Hiệu chỉnh phiếu nhập kho">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">

            <HorizontalStackLayout Spacing="12">
                <Button Text="Tải lại"
                        Command="{Binding LoadDataCommand}" />

                <Button Text="Lưu header"
                        Command="{Binding EditHeaderCommand}" />
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Opacity="0.2" />

            <Label Text="Dòng hàng" FontAttributes="Bold" FontSize="16" />

            <Label Text="Sản phẩm ID" />
            <Entry Text="{Binding SanPhamIdInput}"
                   Keyboard="Numeric"
                   Placeholder="VD: 5" />

            <Label Text="Số lượng" />
            <Entry Text="{Binding SoLuongInput}"
                   Keyboard="Numeric"
                   Placeholder="VD: 10" />

            <Label Text="Đơn giá" />
            <Entry Text="{Binding DonGiaInput}"
                   Keyboard="Numeric"
                   Placeholder="VD: 25000" />

            <HorizontalStackLayout Spacing="12">
                <Button Text="Thêm dòng"
                        Command="{Binding AddLineCommand}" />

                <Button Text="Sửa dòng"
                        Command="{Binding EditLineCommand}" />
            </HorizontalStackLayout>

            <Label Text="Danh sách dòng hàng" FontAttributes="Bold" FontSize="16" />

            <CollectionView ItemsSource="{Binding DanhSachDong}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedLine, Mode=TwoWay}">
                <CollectionView.EmptyView>
                    <Label Text="Chưa có dòng hàng nào."
                           Padding="8"
                           Opacity="0.7" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PhieuNhapKhoRawData">
                        <Grid ColumnDefinitions="*,Auto" Padding="8">

                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Id, StringFormat='ID: {0}'}"
                                           FontSize="12"
                                           Opacity="0.7" />
                                    <Label Text="{Binding SanPhamId, StringFormat='SP: {0}'}"
                                           FontAttributes="Bold" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="12">
                                    <Label Text="{Binding SoLuong, StringFormat='SL: {0}'}" />
                                    <Label Text="{Binding DonGia, StringFormat='ĐG: {0}'}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Xóa"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                      Path=BindingContext.RemoveLineCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>