<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InternProj.Pages.XuatNhapTonDataPage"
    x:Name="XuatNhapTonData"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sfgrid="http://schemas.syncfusion.com/maui"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    Title="Báo cáo xuất nhập tồn"
>

    <ContentPage.Resources>
        <!-- Header style -->
        <Style TargetType="sfgrid:DataGridHeaderCell">
            <Setter Property="Background" Value="#F2F2F2" />
            <Setter Property="TextColor" Value="#222222" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style TargetType="sfgrid:DataGridCell">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="TextColor" Value="#222222" />
        </Style>
        
        
        <!-- Row style -->
        <Style TargetType="sfgrid:DataGridRow">
            <Setter Property="Background" Value="#F2F2F2" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Spacing="12" Padding="16">


        <HorizontalStackLayout Spacing="12">
            <DatePicker
                Date="{Binding StartDate, Mode=TwoWay}"
                Format="dd/MM/yyyy"/>
            <DatePicker
                Date="{Binding EndDate, Mode=TwoWay}"
                Format="dd/MM/yyyy"/>
        </HorizontalStackLayout>
        
        <Button Text="Search"
                    Command="{Binding SearchCommand}" />

            <Label Text="Danh sách hàng nhập"
               FontAttributes="Bold"
               TextColor="White" />

        <sfgrid:SfDataGrid
            AllowEditing="false"
            ItemsSource="{Binding DanhSachHang}"
            AutoGenerateColumnsMode="None"
            SelectionMode="Single"
            GridLinesVisibility="Both"
            HeaderGridLinesVisibility="Both"
            ColumnWidthMode="Fill"
            HeaderRowHeight="44"
            RowHeight="52">

            <sfgrid:SfDataGrid.DefaultStyle>
                <sfgrid:DataGridStyle
            HeaderRowBackground="#F2F2F2"
            HeaderRowTextColor="#222222"
            HeaderGridLineColor="#BDBDBD"
            HeaderGridLineStrokeThickness="1"
            GridLineColor="#BDBDBD"
            GridLineStrokeThickness="1" />
            </sfgrid:SfDataGrid.DefaultStyle>

            <sfgrid:SfDataGrid.Columns>
                <sfgrid:DataGridTextColumn MappingName="MaSP"
                                   HeaderText="Mã sản phẩm" />
                <sfgrid:DataGridTextColumn MappingName="TenSP"
                                   HeaderText="Tên sản phẩm" />
                <sfgrid:DataGridTextColumn MappingName="SoLuongDauKy"
                                   HeaderText="Số lượng đầu kỳ" />
                <sfgrid:DataGridTextColumn MappingName="SoLuongNhap"
                                   HeaderText="Số lượng nhập" />
                <sfgrid:DataGridTextColumn MappingName="SoLuongXuat"
                                   HeaderText="Số lượng xuất" />
                <sfgrid:DataGridTextColumn MappingName="SoLuongCuoiKy"
                                   HeaderText="Số lượng cuối kỳ" />
            </sfgrid:SfDataGrid.Columns>
        </sfgrid:SfDataGrid>

    </VerticalStackLayout>
</ContentPage>