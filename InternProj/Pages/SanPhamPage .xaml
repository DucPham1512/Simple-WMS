<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InternProj.Pages.SanPhamPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:InternProj.Models"
    Title="Loại sản phẩm">

    <VerticalStackLayout Spacing="12" Padding="16">

        <ScrollView Orientation="Horizontal">
            <Grid ColumnSpacing="16" RowSpacing="6"
          RowDefinitions="Auto,Auto"
          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">

                <!-- Column 0: Mã sản phẩm -->
                <Label Grid.Row="0" Grid.Column="0"
               Text="Mã sản phẩm"
               LineBreakMode="TailTruncation"
               MaximumWidthRequest="120" />
                <Entry Grid.Row="1" Grid.Column="0"
               WidthRequest="200"
               Text="{Binding MaSPInput}" />

                <!-- Column 1: Tên sản phẩm -->
                <Label Grid.Row="0" Grid.Column="1"
               Text="Tên sản phẩm"
               LineBreakMode="TailTruncation"
               MaximumWidthRequest="120" />
                <Entry Grid.Row="1" Grid.Column="1"
               WidthRequest="260"
               Text="{Binding TenSPInput}"
               Placeholder="VD: Nước ngọt Pepsi lon 330ml,..." />

                <!-- Column 2: Id Loại sản phẩm -->
                <Label Grid.Row="0" Grid.Column="2"
               Text="Id Loại sản phẩm"
               LineBreakMode="TailTruncation"
               MaximumWidthRequest="130" />
                <Entry Grid.Row="1" Grid.Column="2"
               WidthRequest="160"
               Text="{Binding IdLSPInput}" />

                <!-- Column 3: Id Đơn vị đo -->
                <Label Grid.Row="0" Grid.Column="3"
               Text="Id Đơn vị đo"
               LineBreakMode="TailTruncation"
               MaximumWidthRequest="120" />
                <Entry Grid.Row="1" Grid.Column="3"
               WidthRequest="160"
               Text="{Binding IdDVTInput}" />

                <!-- Column 4: Ghi chú -->
                <Label Grid.Row="0" Grid.Column="4"
               Text="Ghi chú"
               LineBreakMode="TailTruncation"
               MaximumWidthRequest="100" />
                <Entry Grid.Row="1" Grid.Column="4"
               WidthRequest="260"
               Text="{Binding GhiChuInput}"
               Placeholder="Ghi chú (nếu có)" />

            </Grid>
        </ScrollView>
        <!-- Buttons -->
        <HorizontalStackLayout Spacing="12">
            <Button Text="Load"
                    Command="{Binding LoadDataCommand}" />

            <Button Text="Save"
                    Command="{Binding SaveCommand}" />
        </HorizontalStackLayout>

        <!-- List -->
        <Label Text="Danh sách loại sản phẩm" FontAttributes="Bold" />

        <CollectionView ItemsSource="{Binding DanhSachSP}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SanPham">
                    <Grid ColumnDefinitions="*,Auto" Padding="8">
                        <VerticalStackLayout Spacing="2">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Id}" FontAttributes="Bold"/>
                                <Label Text="{Binding Ma_SP}" FontAttributes="Bold" />
                                <Label Text="{Binding Ten_SP}" FontAttributes="Bold" />
                                <Label Text="{Binding Id_LSP}" FontAttributes="Bold"/>
                                <Label Text="{Binding Id_DVT}" FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <Label Text="{Binding Ghi_Chu}" FontSize="12" Opacity="0.7" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Xóa"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>