<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InternProj.Pages.DonViTinhPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:InternProj.Models"
    Title="Đơn vị tính">

    <VerticalStackLayout Spacing="12" Padding="16">

        <!-- Inputs -->
        <Label Text="Tên đơn vị" />
        <Entry Text="{Binding TenDonViInput}" Placeholder="VD: Kg, Thùng, Cái..." />

        <Label Text="Ghi chú" />
        <Entry Text="{Binding GhiChuInput}" Placeholder="Ghi chú (nếu có)" />

        <!-- Buttons -->
        <HorizontalStackLayout Spacing="12">
            <Button Text="Load"
                    Command="{Binding LoadDataCommand}" />

            <Button Text="Save"
                    Command="{Binding SaveCommand}" />
        </HorizontalStackLayout>

        <!-- List -->
        <Label Text="Danh sách đơn vị tính" FontAttributes="Bold" />

        <CollectionView ItemsSource="{Binding DanhSachDonVi}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DonViTinh">
                    <Grid ColumnDefinitions="*,Auto" Padding="8">
                        <VerticalStackLayout>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Id}" FontSize="12" Opacity="0.7" />
                                <Label Text="{Binding Ten_Don_Vi_Tinh}" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Ghi_Chu}" FontSize="12" Opacity="0.7" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Xóa"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>